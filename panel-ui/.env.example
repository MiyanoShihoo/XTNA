# Copilot Runtime model configuration.
#
# Pick one shape. All of them keep the key in this server process; VITE_* vars
# are browser-visible and must never hold a credential.

# --- 1) Provider model string -------------------------------------------------
# COPILOT_MODEL=openai:gpt-5-mini
# OPENAI_API_KEY=
#
# COPILOT_MODEL=anthropic:claude-sonnet-4-6
# ANTHROPIC_API_KEY=
#
# COPILOT_MODEL=google:gemini-3.5-flash
# GOOGLE_API_KEY=
#
# COPILOT_MODEL=minimax:MiniMax-M3
# MINIMAX_API_KEY=

# --- 2) Any OpenAI-compatible endpoint ---------------------------------------
# Transport: COPILOT_API_STYLE=chat (choices/delta, the common case),
# responses (output[]), or auto (responses only for api.openai.com).
# Extra headers for gateways: COPILOT_HEADERS={"HTTP-Referer":"..."}
# OpenRouter / Groq / Together / Ollama / vLLM / LiteLLM / your gateway.
# The model id is passed through unchanged and Chat Completions is used.
# COPILOT_BASE_URL=https://openrouter.ai/api/v1
# COPILOT_API_KEY=sk-or-...
# COPILOT_MODEL=anthropic/claude-sonnet-4-6
#
# Ollama example:
# COPILOT_BASE_URL=http://127.0.0.1:11434/v1
# COPILOT_API_KEY=ollama
# COPILOT_MODEL=qwen2.5:7b

# --- 3) OpenAI-compatible through CopilotKit's own resolver -------------------
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# COPILOT_MODEL=openai:llama-3.3-70b-versatile

COPILOT_PORT=8200
